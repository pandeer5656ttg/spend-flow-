rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.userId == userId &&
             data.isPro is bool &&
             data.subscriptionTier in ['free', 'pro_monthly', 'pro_annual', 'pro_lifetime'];
    }

    function isValidExpense(data, userId) {
      return data.userId == userId &&
             data.id is string && data.id.size() > 0 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 100 &&
             data.amount is number && data.amount >= 0 &&
             data.category is string &&
             data.timestamp is number;
    }

    function isValidRecurringExpense(data, userId) {
      return data.userId == userId &&
             data.id is string && data.id.size() > 0 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 100 &&
             data.amount is number && data.amount >= 0 &&
             data.category is string &&
             data.frequency in ['weekly', 'monthly', 'yearly'] &&
             data.billingDay is number && data.billingDay >= 1 && data.billingDay <= 31 &&
             data.isActive is bool;
    }

    function isValidBudgetGoal(data, userId) {
      return data.userId == userId &&
             data.id is string && data.id.size() > 0 &&
             data.category is string &&
             data.monthlyLimit is number && data.monthlyLimit >= 0 &&
             data.monthYear is string;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data, userId);
      allow update: if isOwner(userId) && isValidUserProfile(request.resource.data, userId);
      allow delete: if isOwner(userId);

      match /expenses/{expenseId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidExpense(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidExpense(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      match /recurring_expenses/{recurringId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidRecurringExpense(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidRecurringExpense(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      match /budget_goals/{goalId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidBudgetGoal(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidBudgetGoal(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
